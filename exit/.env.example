# exit/.env is created and filled by "npm run setup" and "npm run recover".
# Never commit it. Names only here; values are testnet-only demo secrets.

# Optional: any public Base Sepolia RPC (default https://sepolia.base.org)
RPC_URL=

# Written by setup
LOST_OWNER_PRIVATE_KEY=
RECOVERY_PHRASE=
GUARDIAN_1_PRIVATE_KEY=
GUARDIAN_2_PRIVATE_KEY=
GUARDIAN_3_PRIVATE_KEY=
SAFE_SALT_NONCE=
SAFE_ADDRESS=

# Written by recover
NEW_OWNER_PRIVATE_KEY=

# Optional: where recover sends the USDC (default: the new owner address)
RECIPIENT_ADDRESS=
